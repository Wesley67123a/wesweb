<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>金花房間 1:1 像素還原 (1080p 可操控版)</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      background: #000000;
      color: #ffffff;
      font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC", sans-serif;
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
    }

    .app-shell {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 12px;
      gap: 10px;
      background: #000000;
    }

    .stage-wrap {
      position: relative;
      width: 100%;
      max-width: 1920px;
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #sceneCanvas {
      display: block;
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      aspect-ratio: 16 / 9;
      background: #000000;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }

    .hud-bar {
      width: 100%;
      max-width: 960px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 8px 12px;
      background: #0b0b10;
      border: 1px solid #3f3f46;
      border-radius: 4px;
    }

    .btn-group {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
    }

    .ut-btn {
      appearance: none;
      background: #000000;
      color: #ffffff;
      border: 1px solid #f59e0b;
      border-radius: 3px;
      padding: 6px 11px;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: background 0.14s ease, color 0.14s ease, border-color 0.14s ease;
      min-height: 34px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .ut-btn:hover {
      background: #f59e0b;
      color: #000000;
    }

    .ut-btn.active {
      background: #facc15;
      border-color: #facc15;
      color: #000000;
    }

    .ut-btn.secondary {
      border-color: #52525b;
      color: #e4e4e7;
    }

    .ut-btn.secondary:hover {
      border-color: #ffffff;
      background: #27272a;
      color: #ffffff;
    }

    .dpad-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
    }

    .dpad-btn {
      width: 40px;
      height: 36px;
      background: #14141c;
      color: #ffffff;
      border: 1px solid #71717a;
      border-radius: 4px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      touch-action: none;
    }

    .dpad-btn:active, .dpad-btn.pressed {
      background: #facc15;
      border-color: #facc15;
      color: #000000;
    }

    .status-pill {
      font-size: 12px;
      font-weight: 400;
      color: #a1a1aa;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }

    @media (max-width: 640px) {
      .app-shell {
        padding: 8px;
        gap: 8px;
      }
      .hud-bar {
        padding: 8px;
        justify-content: center;
      }
      .ut-btn {
        padding: 5px 9px;
        font-size: 12px;
      }
      .dpad-btn {
        width: 44px;
        height: 40px;
      }
      .status-pill {
        width: 100%;
        text-align: center;
      }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <div class="stage-wrap" id="stageWrap">
      <canvas id="sceneCanvas" width="1920" height="1080" aria-label="金花房間 1:1 像素還原 (1920x1080)"></canvas>
    </div>

    <div class="hud-bar" role="toolbar" aria-label="操控與動畫工具列">
      <div class="dpad-wrap" id="dpadWrap" aria-label="方向鍵控制">
        <button type="button" class="dpad-btn" data-dir="left" aria-label="向左走">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="dpad-btn" data-dir="up" aria-label="向上走">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="18 15 12 9 6 15"/></svg>
        </button>
        <button type="button" class="dpad-btn" data-dir="down" aria-label="向下走">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <button type="button" class="dpad-btn" data-dir="right" aria-label="向右走">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>

      <div class="btn-group">
        <button type="button" class="ut-btn active" id="modeBtn">模式：手動操控</button>
        <button type="button" class="ut-btn secondary" id="playPauseBtn">▶ 自動往右走</button>
        <button type="button" class="ut-btn secondary" id="replayBtn">↺ 回原位</button>
        <button type="button" class="ut-btn secondary" id="speedBtn">速度 1x</button>
        <button type="button" class="ut-btn secondary" id="sfxBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
          音效：關
        </button>
        <button type="button" class="ut-btn secondary" id="fullscreenBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
          1080p 全螢幕
        </button>
      </div>

      <span class="status-pill" id="statusText">1920×1080 · 手動操控（方向鍵 / WASD）</span>
    </div>
  </div>

  <script>
    (function () {
      const ASSETS = {
        bg: "data:image/png;base64,",
        bg2: "data:image/png;base64,",
        floweyPortrait: "data:image/png;base64,",
        frontIdle: "data:image/png;base64,",
        frontWalk1: "data:image/png;base64,",
        frontWalk2: "data:image/png;base64,",
        backIdle: "data:image/png;base64,",
        backWalk1: "data:image/png;base64,",
        backWalk2: "data:image/png;base64,",
        rightIdle: "data:image/png;base64,",
        rightWalk1: "data:image/png;base64,",
        rightWalk2: "data:image/png;base64,",
        leftIdle: "data:image/png;base64,",
        leftWalk1: "data:image/png;base64,",
        leftWalk2: "data:image/png;base64,"
      };

      const NATIVE_W = 739;
      const NATIVE_H = 415;
      const OUT_W = 1920;
      const OUT_H = 1080;
      const SCALE_X = OUT_W / NATIVE_W;
      const SCALE_Y = OUT_H / NATIVE_H;

      // Exact original character footprint matching IMG_6059.png & IMG_6060.png
      const START_X = 335;
      const START_Y = 189;
      const SPRITE_W = 36;
      const SPRITE_H = 55;
      const CORRIDOR_EXIT_X = 646;
      const ROOM2_H = 660;

      const canvas = document.getElementById("sceneCanvas");
      const ctx = canvas.getContext("2d");
      const stageWrap = document.getElementById("stageWrap");

      const playPauseBtn = document.getElementById("playPauseBtn");
      const replayBtn = document.getElementById("replayBtn");
      const speedBtn = document.getElementById("speedBtn");
      const modeBtn = document.getElementById("modeBtn");
      const sfxBtn = document.getElementById("sfxBtn");
      const fullscreenBtn = document.getElementById("fullscreenBtn");
      const dpadWrap = document.getElementById("dpadWrap");
      const statusText = document.getElementById("statusText");

      const images = {};
      let assetsReady = false;

      // Default to Manual Control so user can walk right away
      const SPEEDS = [0.5, 1, 1.5, 2];
      let speedIdx = 1;
      let isPlaying = false;
      let mode = "manual"; // "manual" | "auto"
      let sfxEnabled = false;
      let audioCtx = null;

      // Room & character state
      let currentRoom = 1;  // 1 = 金花房間, 2 = 小花房間
      let charX = START_X;
      let charY = START_Y;
      let facing = "front"; // "front" | "back" | "right" | "left"
      let walkPhase = 1;    // 0=walk1, 1=idle, 2=walk2, 3=idle
      let walkTimer = 0;
      let autoElapsed = 0;
      let fadeAlpha = 0;
      let lastStepIdx = -1;
      let transition = null; // { phase: "out"|"in", timer, dur, targetRoom, spawnX, spawnY, spawnFacing }
      let cameraY = 0;

      // Classic Flowey dialogue state (per reference video)
      const FLOWEY_LINES = [
        "* Howdy! I'm FLOWEY.\n  FLOWEY the FLOWER!",
        "* Hmm...\n  You're new to the UNDERGROUND, aren'tcha?",
        "* Golly, you must be so confused.",
        "* Someone ought to teach you how things\n  work around here!",
        "* I guess little old me will have to do."
      ];
      let floweyMet = false;
      let dlgActive = false;
      let dlgIndex = 0;
      let dlgCharCount = 0;
      let dlgLastBeep = 0;

      const keys = { left: false, right: false, up: false, down: false };

      // Room walkable bounds for feet
      function isInsideRoom(x, y) {
        const fx = x + SPRITE_W * 0.5;
        const fy = y + SPRITE_H - 4;
        if (currentRoom === 1) {
          if (fy < 104 || fy > 390) return false;
          if (fy < 126) return fx >= 206 && fx <= 498;
          if (fy < 258) return fx >= 140 && fx <= 564;
          if (fy <= 326) return fx >= 140 && fx <= 656;
          if (fy < 362) return fx >= 204 && fx <= 500;
          return fx >= 240 && fx <= 464;
        }
        // Room 2 (room_area1_2): exact octagonal perimeter & archway B / entrance A
        if (fy < 224 || fy > 658) return false;
        // Top Ruins archway doorway B (fy 224..255)
        if (fy < 255) return fx >= 324 && fx <= 415;
        // Upper octagonal taper (fy 255..335)
        if (fy < 335) {
          const p = (fy - 255) / 80;
          const halfW = 85 + p * 145;
          return Math.abs(fx - 369.5) <= halfW;
        }
        // Lower octagonal taper toward entrance A (fy 525..605)
        if (fy > 605) {
          return fx >= 315 && fx <= 424;
        }
        if (fy > 525) {
          const p = (605 - fy) / 80;
          const halfW = 55 + p * 175;
          return Math.abs(fx - 369.5) <= halfW;
        }
        // Central chamber width
        if (Math.abs(fx - 369.5) > 230) return false;
        // Avoid walking directly through Flowey
        if (fx > 348 && fx < 391 && fy > 438 && fy < 474) return false;
        return true;
      }

      function startRoomTransition(targetRoom, spawnX, spawnY, spawnFacing) {
        if (transition) return;
        transition = {
          phase: "out",
          timer: 0,
          dur: 0.28,
          targetRoom: targetRoom,
          spawnX: spawnX,
          spawnY: spawnY,
          spawnFacing: spawnFacing
        };
      }

      function ensureAudio() {
        if (!audioCtx) {
          const AudioContextCls = window.AudioContext || window.webkitAudioContext;
          if (AudioContextCls) audioCtx = new AudioContextCls();
        }
        if (audioCtx && audioCtx.state === "suspended") {
          audioCtx.resume().catch(function () {});
        }
      }

      function playFootstep(onFlowers) {
        if (!sfxEnabled || !audioCtx) return;
        try {
          const now = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = onFlowers ? "triangle" : "square";
          const baseFreq = onFlowers ? 260 : 155;
          osc.frequency.setValueAtTime(baseFreq, now);
          osc.frequency.exponentialRampToValueAtTime(baseFreq * 0.55, now + 0.045);

          gain.gain.setValueAtTime(0.035, now);
          gain.gain.exponentialRampToValueAtTime(0.0008, now + 0.05);

          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.055);
        } catch (e) {
          // Ignore audio scheduling error
        }
      }

      function isOnFlowerbed(x, y) {
        const fx = x + SPRITE_W * 0.5;
        const fy = y + SPRITE_H - 4;
        if (currentRoom === 1) {
          return fx >= 300 && fx <= 404 && fy >= 192 && fy <= 258;
        }
        return fx >= 324 && fx <= 415 && fy >= 440 && fy <= 488;
      }

      function playFloweyVoice() {
        if (!sfxEnabled || !audioCtx) return;
        try {
          const now = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = "square";
          osc.frequency.setValueAtTime(510 + Math.random() * 45, now);
          gain.gain.setValueAtTime(0.025, now);
          gain.gain.exponentialRampToValueAtTime(0.0008, now + 0.038);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.04);
        } catch (e) {}
      }

      function startFloweyDialogue() {
        dlgActive = true;
        dlgIndex = 0;
        dlgCharCount = 0;
        dlgLastBeep = 0;
        floweyMet = true;
        facing = "back";
        walkPhase = 1;
        updateStatus();
      }

      function advanceDialogue() {
        if (!dlgActive) return false;
        const fullLen = FLOWEY_LINES[dlgIndex].length;
        if (dlgCharCount < fullLen) {
          dlgCharCount = fullLen;
          return true;
        }
        dlgIndex += 1;
        if (dlgIndex >= FLOWEY_LINES.length) {
          dlgActive = false;
          updateStatus();
        } else {
          dlgCharCount = 0;
          dlgLastBeep = 0;
        }
        return true;
      }

      function updateCamera() {
        if (currentRoom === 1) {
          cameraY = 0;
        } else {
          const maxCam = ROOM2_H - NATIVE_H;
          const target = Math.max(0, Math.min(maxCam, charY + SPRITE_H * 0.5 - NATIVE_H * 0.52));
          cameraY = target;
        }
      }

      function resizeCanvas() {
        if (!stageWrap) return;
        const rect = stageWrap.getBoundingClientRect();
        const scale = Math.min(rect.width / OUT_W, rect.height / OUT_H);
        const cssW = Math.max(1, Math.floor(OUT_W * scale));
        const cssH = Math.max(1, Math.floor(OUT_H * scale));
        canvas.style.width = cssW + "px";
        canvas.style.height = cssH + "px";
        if (assetsReady) render();
      }

      function resetCharacter() {
        currentRoom = 1;
        transition = null;
        cameraY = 0;
        floweyMet = false;
        dlgActive = false;
        charX = START_X;
        charY = START_Y;
        facing = "front";
        walkPhase = 1;
        walkTimer = 0;
        autoElapsed = 0;
        fadeAlpha = 0;
        lastStepIdx = -1;
        updateStatus();
      }

      function syncModeUI() {
        if (mode === "manual") {
          modeBtn.textContent = "模式：手動操控";
          modeBtn.classList.add("active");
          modeBtn.classList.remove("secondary");
          playPauseBtn.textContent = "▶ 自動往右走";
          playPauseBtn.classList.remove("active");
          playPauseBtn.classList.add("secondary");
        } else {
          modeBtn.textContent = "模式：自動動畫";
          modeBtn.classList.remove("active");
          modeBtn.classList.add("secondary");
          playPauseBtn.textContent = isPlaying ? "❚❚ 暫停" : "▶ 繼續";
          playPauseBtn.classList.toggle("active", isPlaying);
          playPauseBtn.classList.toggle("secondary", !isPlaying);
        }
        updateStatus();
      }

      function updateStatus() {
        const roomLabel = currentRoom === 1 ? "房間 1：金花房間" : "房間 2：小花房間";
        if (dlgActive) {
          statusText.textContent = roomLabel + " · 按 Z / Enter 或點擊畫面繼續對話";
        } else if (mode === "manual") {
          statusText.textContent = roomLabel + " · 方向鍵 / WASD 移動（Z 互動）";
        } else if (!isPlaying) {
          statusText.textContent = roomLabel + " · 自動動畫已暫停";
        } else {
          statusText.textContent = roomLabel + " · 自動往右走示範中";
        }
      }

      function updateAuto(dt) {
        const TOTAL = 10.6;
        autoElapsed += dt * 1.55;
        if (autoElapsed >= TOTAL) {
          autoElapsed = autoElapsed % TOTAL;
          lastStepIdx = -1;
        }

        const t = autoElapsed;
        let moving = false;
        const prevRoom = currentRoom;

        if (t < 0.85) {
          currentRoom = 1;
          charX = START_X; charY = START_Y; facing = "front"; fadeAlpha = 0;
        } else if (t < 1.15) {
          currentRoom = 1;
          charX = START_X; charY = START_Y; facing = "right"; fadeAlpha = 0;
        } else if (t < 3.35) {
          currentRoom = 1;
          const p = (t - 1.15) / 2.20;
          charX = START_X + (495 - START_X) * p; charY = START_Y; facing = "right"; moving = true; fadeAlpha = 0;
        } else if (t < 4.45) {
          currentRoom = 1;
          const p = (t - 3.35) / 1.10;
          charX = 495 + (565 - 495) * p; charY = START_Y + (242 - START_Y) * p; facing = "right"; moving = true; fadeAlpha = 0;
        } else if (t < 5.60) {
          currentRoom = 1;
          const p = (t - 4.45) / 1.15;
          charX = 565 + (648 - 565) * p; charY = 242; facing = "right"; moving = true; fadeAlpha = 0;
        } else if (t < 6.05) {
          currentRoom = 1;
          charX = 648; charY = 242; facing = "right"; fadeAlpha = (t - 5.60) / 0.45;
        } else if (t < 6.45) {
          currentRoom = 2;
          charX = 351; charY = 590; facing = "back"; fadeAlpha = 1 - (t - 6.05) / 0.40;
        } else if (t < 7.65) {
          currentRoom = 2;
          const p = (t - 6.45) / 1.20;
          charX = 351; charY = 590 + (505 - 590) * p; facing = "back"; moving = true; fadeAlpha = 0;
        } else if (t < 9.55) {
          currentRoom = 2;
          charX = 351; charY = 505; facing = "back"; fadeAlpha = 0;
        } else if (t < 10.05) {
          currentRoom = 2;
          charX = 351; charY = 505; facing = "back"; fadeAlpha = (t - 9.55) / 0.50;
        } else {
          currentRoom = 1;
          charX = START_X; charY = START_Y; facing = "front"; fadeAlpha = 1 - (t - 10.05) / 0.55;
        }

        if (currentRoom !== prevRoom) updateStatus();
        updateCamera();

        if (moving) {
          const stepIndex = Math.floor(t * 9.2);
          walkPhase = stepIndex % 4;
          if (stepIndex !== lastStepIdx && (walkPhase === 0 || walkPhase === 2)) {
            playFootstep(isOnFlowerbed(charX, charY));
          }
          lastStepIdx = stepIndex;

          updateCamera();

          // Auto-trigger Flowey greeting the first time player walks up to Flowey
          if (currentRoom === 2 && !floweyMet && charY <= 520 && charY >= 465 && Math.abs((charX + SPRITE_W * 0.5) - 369.5) < 75) {
            startFloweyDialogue();
            return;
          }

          // Check room exit transitions
          if (currentRoom === 1 && charX + SPRITE_W >= 644 && (charY + SPRITE_H - 4) >= 254 && (charY + SPRITE_H - 4) <= 328) {
            startRoomTransition(2, 351, 588, "back");
          } else if (currentRoom === 2 && charY + SPRITE_H >= 654) {
            startRoomTransition(1, 592, 240, "left");
          }
        } else {
          walkPhase = 1;
        }
      }

      function updateManual(dt) {
        if (transition) {
          transition.timer += dt;
          if (transition.phase === "out") {
            fadeAlpha = Math.min(1, transition.timer / transition.dur);
            if (transition.timer >= transition.dur) {
              currentRoom = transition.targetRoom;
              charX = transition.spawnX;
              charY = transition.spawnY;
              facing = transition.spawnFacing;
              walkPhase = 1;
              transition.phase = "in";
              transition.timer = 0;
              updateCamera();
              updateStatus();
            }
          } else {
            fadeAlpha = Math.max(0, 1 - transition.timer / transition.dur);
            if (transition.timer >= transition.dur) {
              fadeAlpha = 0;
              transition = null;
            }
          }
          return;
        }

        if (dlgActive) {
          const line = FLOWEY_LINES[dlgIndex];
          if (dlgCharCount < line.length) {
            const prevInt = Math.floor(dlgCharCount);
            dlgCharCount = Math.min(line.length, dlgCharCount + dt * 28);
            const curInt = Math.floor(dlgCharCount);
            if (curInt > prevInt && curInt - dlgLastBeep >= 2) {
              const ch = line.charAt(curInt - 1);
              if (ch && ch !== " " && ch !== "\n") {
                playFloweyVoice();
                dlgLastBeep = curInt;
              }
            }
          }
          return;
        }

        const moveSpeed = 152; // brisk Undertale walking pace
        let dx = 0;
        let dy = 0;
        if (keys.right) dx += 1;
        if (keys.left) dx -= 1;
        if (keys.down) dy += 1;
        if (keys.up) dy -= 1;

        fadeAlpha = 0;

        if (dx !== 0 || dy !== 0) {
          const len = Math.hypot(dx, dy);
          const nx = charX + (dx / len) * moveSpeed * dt;
          const ny = charY + (dy / len) * moveSpeed * dt;

          if (isInsideRoom(nx, charY)) charX = nx;
          if (isInsideRoom(charX, ny)) charY = ny;

          if (dx > 0) facing = "right";
          else if (dx < 0) facing = "left";
          else if (dy > 0) facing = "front";
          else if (dy < 0) facing = "back";

          walkTimer += dt * 9.5;
          const stepIndex = Math.floor(walkTimer);
          walkPhase = stepIndex % 4;
          if (stepIndex !== lastStepIdx && (walkPhase === 0 || walkPhase === 2)) {
            playFootstep(isOnFlowerbed(charX, charY));
          }
          lastStepIdx = stepIndex;
        } else {
          walkPhase = 1;
          walkTimer = 0;
          lastStepIdx = -1;
        }
      }

      function getCurrentSprite() {
        if (facing === "front") {
          if (walkPhase === 0) return images.frontWalk1;
          if (walkPhase === 2) return images.frontWalk2;
          return images.frontIdle;
        }
        if (facing === "back") {
          if (walkPhase === 0) return images.backWalk1;
          if (walkPhase === 2) return images.backWalk2;
          return images.backIdle;
        }
        if (facing === "left") {
          if (walkPhase === 0) return images.leftWalk1;
          if (walkPhase === 2) return images.leftWalk2;
          return images.leftIdle;
        }
        if (walkPhase === 0) return images.rightWalk1;
        if (walkPhase === 2) return images.rightWalk2;
        return images.rightIdle;
      }

      function render() {
        ctx.imageSmoothingEnabled = false;
        ctx.clearRect(0, 0, OUT_W, OUT_H);

        // 1. Exact 1:1 room background at 1920x1080 with zero anti-aliasing & vertical camera scroll in Room 2
        if (currentRoom === 1) {
          ctx.drawImage(images.bg, 0, 0, OUT_W, OUT_H);
        } else {
          const camPx = Math.round(cameraY);
          ctx.drawImage(images.bg2, 0, camPx, NATIVE_W, NATIVE_H, 0, 0, OUT_W, OUT_H);
        }

        // 2. Crisp 1:1 Frisk sprite (offset by cameraY in Room 2)
        const sprite = getCurrentSprite();
        const drawX = Math.round(charX * SCALE_X);
        const drawY = Math.round((charY - cameraY) * SCALE_Y);
        const drawW = Math.round(SPRITE_W * SCALE_X);
        const drawH = Math.round(SPRITE_H * SCALE_Y);

        ctx.save();
        if (currentRoom === 1) {
          ctx.beginPath();
          ctx.rect(0, 0, Math.round(CORRIDOR_EXIT_X * SCALE_X), OUT_H);
          ctx.clip();
        }
        ctx.drawImage(sprite, drawX, drawY, drawW, drawH);
        ctx.restore();

        // 2.5 Classic Undertale Flowey dialogue box
        if (dlgActive) {
          const bx = 280, by = 48, bw = 1360, bh = 290;
          ctx.fillStyle = "#000000";
          ctx.fillRect(bx, by, bw, bh);
          ctx.strokeStyle = "#ffffff";
          ctx.lineWidth = 10;
          ctx.strokeRect(bx + 5, by + 5, bw - 10, bh - 10);

          // Flowey portrait
          if (images.floweyPortrait) {
            ctx.drawImage(images.floweyPortrait, bx + 54, by + 56, 178, 178);
          }

          // Typewriter dialogue text
          ctx.fillStyle = "#ffffff";
          ctx.font = '42px "Courier New", monospace';
          ctx.textBaseline = "top";
          const shown = FLOWEY_LINES[dlgIndex].slice(0, Math.floor(dlgCharCount));
          const lines = shown.split("\n");
          for (let i = 0; i < lines.length; i++) {
            ctx.fillText(lines[i], bx + 275, by + 62 + i * 64);
          }

          // Next indicator
          if (dlgCharCount >= FLOWEY_LINES[dlgIndex].length) {
            ctx.fillStyle = "#facc15";
            ctx.font = '28px "Courier New", monospace';
            ctx.fillText("▼ Z / 點擊繼續", bx + bw - 285, by + bh - 56);
          }
        }

        // 3. Optional fade overlay during auto loop
        if (fadeAlpha > 0.001) {
          ctx.fillStyle = "rgba(0, 0, 0, " + Math.min(1, Math.max(0, fadeAlpha)).toFixed(3) + ")";
          ctx.fillRect(0, 0, OUT_W, OUT_H);
        }
      }

      let rafId = null;
      let prevTime = 0;

      function loop(now) {
        if (!prevTime) prevTime = now;
        const rawDt = Math.min(0.05, (now - prevTime) / 1000);
        prevTime = now;
        const dt = rawDt * SPEEDS[speedIdx];

        if (assetsReady) {
          if (mode === "auto") {
            if (isPlaying) updateAuto(dt);
          } else {
            updateManual(dt);
          }
          render();
        }
        rafId = requestAnimationFrame(loop);
      }

      // Controls
      modeBtn.addEventListener("click", function () {
        if (mode === "manual") {
          mode = "auto";
          isPlaying = true;
          resetCharacter();
        } else {
          mode = "manual";
          isPlaying = false;
          fadeAlpha = 0;
          if (!isInsideRoom(charX, charY)) {
            charX = START_X;
            charY = START_Y;
            facing = "front";
          }
        }
        syncModeUI();
      });

      playPauseBtn.addEventListener("click", function () {
        if (mode === "manual") {
          mode = "auto";
          isPlaying = true;
          resetCharacter();
        } else {
          isPlaying = !isPlaying;
        }
        syncModeUI();
      });

      replayBtn.addEventListener("click", function () {
        resetCharacter();
        if (assetsReady) render();
        syncModeUI();
      });

      speedBtn.addEventListener("click", function () {
        speedIdx = (speedIdx + 1) % SPEEDS.length;
        speedBtn.textContent = "速度 " + SPEEDS[speedIdx] + "x";
      });

      sfxBtn.addEventListener("click", function () {
        sfxEnabled = !sfxEnabled;
        if (sfxEnabled) ensureAudio();
        sfxBtn.innerHTML = sfxEnabled
          ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg> 音效：開'
          : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg> 音效：關';
        sfxBtn.classList.toggle("active", sfxEnabled);
      });

      fullscreenBtn.addEventListener("click", function () {
        const target = stageWrap;
        if (!document.fullscreenElement) {
          if (target.requestFullscreen) target.requestFullscreen().catch(function () {});
        } else if (document.exitFullscreen) {
          document.exitFullscreen().catch(function () {});
        }
      });

      // Keyboard input
      function switchToManualIfNeeded() {
        if (mode !== "manual") {
          mode = "manual";
          isPlaying = false;
          fadeAlpha = 0;
          if (!isInsideRoom(charX, charY)) {
            charX = START_X;
            charY = START_Y;
          }
          syncModeUI();
        }
      }

      function setDirKey(code, pressed) {
        let dir = null;
        if (code === "ArrowRight" || code === "KeyD") dir = "right";
        else if (code === "ArrowLeft" || code === "KeyA") dir = "left";
        else if (code === "ArrowUp" || code === "KeyW") dir = "up";
        else if (code === "ArrowDown" || code === "KeyS") dir = "down";

        if (dir) {
          keys[dir] = pressed;
          if (pressed) switchToManualIfNeeded();
          return true;
        }
        return false;
      }

      window.addEventListener("keydown", function (e) {
        if (e.code === "KeyZ" || e.code === "Enter" || e.code === "Space") {
          if (dlgActive) {
            e.preventDefault();
            advanceDialogue();
            return;
          }
          if (currentRoom === 2 && mode === "manual") {
            const dist = Math.hypot((charX + SPRITE_W * 0.5) - 369.5, (charY + SPRITE_H * 0.5) - 462);
            if (dist < 105) {
              e.preventDefault();
              startFloweyDialogue();
              return;
            }
          }
        }
        if (setDirKey(e.code, true)) {
          e.preventDefault();
          return;
        }
        if (e.code === "KeyR") {
          e.preventDefault();
          replayBtn.click();
        }
      });

      canvas.addEventListener("click", function () {
        if (dlgActive) advanceDialogue();
      });

      window.addEventListener("keyup", function (e) {
        setDirKey(e.code, false);
      });

      // Touch / pointer D-pad
      const dpadButtons = dpadWrap.querySelectorAll(".dpad-btn");
      dpadButtons.forEach(function (btn) {
        const dir = btn.getAttribute("data-dir");
        const startHold = function (e) {
          e.preventDefault();
          switchToManualIfNeeded();
          keys[dir] = true;
          btn.classList.add("pressed");
        };
        const endHold = function (e) {
          e.preventDefault();
          keys[dir] = false;
          btn.classList.remove("pressed");
        };
        btn.addEventListener("pointerdown", startHold);
        btn.addEventListener("pointerup", endHold);
        btn.addEventListener("pointerleave", endHold);
        btn.addEventListener("pointercancel", endHold);
      });

      function loadAllAssets(onDone) {
        const entries = Object.keys(ASSETS);
        let loaded = 0;
        entries.forEach(function (key) {
          const img = new Image();
          img.onload = function () {
            images[key] = img;
            loaded += 1;
            if (loaded === entries.length) {
              assetsReady = true;
              onDone();
            }
          };
          img.src = ASSETS[key];
        });
      }

      window.addEventListener("resize", resizeCanvas);
      window.addEventListener("load", function () {
        resizeCanvas();
        syncModeUI();
        loadAllAssets(function () {
          render();
          if (rafId) cancelAnimationFrame(rafId);
          prevTime = 0;
          rafId = requestAnimationFrame(loop);
        });
      });
    })();
  </script>
</body>
</html>
